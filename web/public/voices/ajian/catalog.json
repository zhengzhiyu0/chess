  {
    "id": "ajian_tactic_zwischenzug_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "tactic_zwischenzug",
    "text": "交换排后边，狠招先来。",
    "file": "ajian_tactic_zwischenzug_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_tactic_zwischenzug_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "tactic_zwischenzug",
    "text": "你把次序玩明白了。",
    "file": "ajian_tactic_zwischenzug_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_tactic_sacrifice_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "tactic_sacrifice",
    "text": "舍一枚，换个大动静。",
    "file": "ajian_tactic_sacrifice_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_tactic_sacrifice_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "tactic_sacrifice",
    "text": "你这不是送，是算过的买卖。",
    "file": "ajian_tactic_sacrifice_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_tactic_sacrifice_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "tactic_sacrifice",
    "text": "棋子先借出去，主动权收回来。",
    "file": "ajian_tactic_sacrifice_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_tactic_sacrifice_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "tactic_sacrifice",
    "text": "敢弃也敢算，有点东西。",
    "file": "ajian_tactic_sacrifice_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_key_threat_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "key_threat",
    "text": "我有个小计划，你最好现在看。",
    "file": "ajian_key_threat_01.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_key_threat_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "key_threat",
    "text": "这威胁，可别当彩蛋漏了。",
    "file": "ajian_key_threat_02.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_key_threat_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "key_threat",
    "text": "先处理这儿，别忙着逛棋盘。",
    "file": "ajian_key_threat_03.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_key_threat_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "key_threat",
    "text": "我下一招，可能不太客气哦。",
    "file": "ajian_key_threat_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_check_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "check",
    "text": "将军！你的王接到通知啦。",
    "file": "ajian_check_01.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_check_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "check",
    "text": "王先忙别的？不行，得应将。",
    "file": "ajian_check_02.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_check_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "check",
    "text": "这一将，叫你暂停一下。",
    "file": "ajian_check_03.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_check_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "check",
    "text": "你的王，轮到它答题啦。",
    "file": "ajian_check_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "ajian_player_check_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_check",
    "text": "你也将军？有来有回嘛。",
    "file": "ajian_player_check_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_player_check_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_check",
    "text": "我的王被你点到名了。",
    "file": "ajian_player_check_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_player_check_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_check",
    "text": "这将军收到了，我来解题。",
    "file": "ajian_player_check_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_player_check_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_check",
    "text": "哎，这回是我先躲一躲。",
    "file": "ajian_player_check_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_missed_mate_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "missed_mate",
    "text": "刚才有杀棋，你没捡到。",
    "file": "ajian_missed_mate_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_missed_mate_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "missed_mate",
    "text": "通关按钮亮过，可惜漏按了。",
    "file": "ajian_missed_mate_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_missed_mate_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "missed_mate",
    "text": "差点就能结束，你拐了个弯。",
    "file": "ajian_missed_mate_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_missed_mate_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "missed_mate",
    "text": "杀棋从眼皮底下溜走啦。",
    "file": "ajian_missed_mate_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_blunder_into_mate_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "blunder_into_mate",
    "text": "这步直接踩到必杀了。",
    "file": "ajian_blunder_into_mate_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_blunder_into_mate_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "blunder_into_mate",
    "text": "王走进死胡同，没地方转弯啦。",
    "file": "ajian_blunder_into_mate_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_blunder_into_mate_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "blunder_into_mate",
    "text": "糟糕，出口被你自己绕没了。",
    "file": "ajian_blunder_into_mate_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_blunder_into_mate_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "blunder_into_mate",
    "text": "这一手，把结尾给接上了。",
    "file": "ajian_blunder_into_mate_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_mate_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "mate",
    "text": "将杀，闯关到此啦。",
    "file": "ajian_mate_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_mate_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "mate",
    "text": "王没路了，这盘结束。",
    "file": "ajian_mate_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_mate_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "mate",
    "text": "这一局玩完，下一局再斗。",
    "file": "ajian_mate_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_mate_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "mate",
    "text": "将杀成立，收棋啦。",
    "file": "ajian_mate_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_castling_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "castling",
    "text": "易位搬家，王的包都收好了。",
    "file": "ajian_castling_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_castling_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "castling",
    "text": "王住稳了，车终于能出门。",
    "file": "ajian_castling_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_castling_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "castling",
    "text": "这次搬家，效率挺高。",
    "file": "ajian_castling_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_castling_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "castling",
    "text": "王车一起换位置，配合上线。",
    "file": "ajian_castling_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_promotion_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "promotion",
    "text": "小兵通关，领取新身份！",
    "file": "ajian_promotion_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_promotion_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "promotion",
    "text": "兵到底啦，升级成功。",
    "file": "ajian_promotion_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_promotion_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "promotion",
    "text": "小个子走出了大出息。",
    "file": "ajian_promotion_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_promotion_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "promotion",
    "text": "新棋子加入，玩法又变啦。",
    "file": "ajian_promotion_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "ajian_queen_early_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "queen_early",
    "text": "后出来遛早了，被人追呀。",
    "file": "ajian_queen_early_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_queen_early_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "queen_early",
    "text": "其他子还宅着，后先跑啦。",
    "file": "ajian_queen_early_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_queen_early_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "queen_early",
    "text": "这次出后，节奏有点亏。",
    "file": "ajian_queen_early_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_queen_early_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "queen_early",
    "text": "别让后一个人开全图啊。",
    "file": "ajian_queen_early_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_defense_found_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "defense_found",
    "text": "守住了，差点以为你要翻车。",
    "file": "ajian_defense_found_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_defense_found_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "defense_found",
    "text": "你把那个坑绕过去啦。",
    "file": "ajian_defense_found_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_defense_found_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "defense_found",
    "text": "这防守，真能救场。",
    "file": "ajian_defense_found_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_defense_found_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "defense_found",
    "text": "最难的一下，你还接住了。",
    "file": "ajian_defense_found_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_player_missed_tactic_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_missed_tactic",
    "text": "这儿有小机关，你没发现。",
    "file": "ajian_player_missed_tactic_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_player_missed_tactic_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_missed_tactic",
    "text": "战术彩蛋被你跳过啦。",
    "file": "ajian_player_missed_tactic_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_player_missed_tactic_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_missed_tactic",
    "text": "再连着看两步，就不一样了。",
    "file": "ajian_player_missed_tactic_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_player_missed_tactic_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "player_missed_tactic",
    "text": "有机会没抓，亏个小惊喜。",
    "file": "ajian_player_missed_tactic_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_comeback_01",
    "role": "ajian",
    "coachIndex": 5,
    "category": "comeback",
    "text": "这都让你追回来了，有韧劲。",
    "file": "ajian_comeback_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_comeback_02",
    "role": "ajian",
    "coachIndex": 5,
    "category": "comeback",
    "text": "原来你还留着复活的本事。",
    "file": "ajian_comeback_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_comeback_03",
    "role": "ajian",
    "coachIndex": 5,
    "category": "comeback",
    "text": "局面又能玩了，别再掉坑。",
    "file": "ajian_comeback_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "ajian_comeback_04",
    "role": "ajian",
    "coachIndex": 5,
    "category": "comeback",
    "text": "你把逆风局打回来了嘛。",
    "file": "ajian_comeback_04.m4a",
    "actors": [
      "player"
    ]
  }
]
