    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_brilliant_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_brilliant",
    "text": "这招够巧，我得另眼相看。",
    "file": "meiyi_player_brilliant_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_brilliant_05",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_brilliant",
    "text": "这一手，值得我少念叨两句。",
    "file": "meiyi_player_brilliant_05.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_lia_best_move_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "lia_best_move",
