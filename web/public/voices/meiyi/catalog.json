    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_lia_best_move_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "lia_best_move",
    "text": "该我动点心思了。",
    "file": "meiyi_lia_best_move_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_capture_pawn_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "capture_pawn",
    "text": "一兵也是钱，我先收着。",
