    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_best_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_best",
    "text": "好棋，我也得费点心了。",
    "file": "meiyi_player_best_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_brilliant_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_brilliant",
    "text": "哎哟，这一下真有两把刷子。",
