    ]
  },
  {
    "id": "meiyi_tactic_zwischenzug_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_zwischenzug",
    "text": "你先插一手，倒挺会抓时候。",
    "file": "meiyi_tactic_zwischenzug_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_tactic_zwischenzug_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_zwischenzug",
    "text": "回吃不急，这招更要紧。",
    "file": "meiyi_tactic_zwischenzug_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_tactic_zwischenzug_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_zwischenzug",
    "text": "把次序换一换，便宜就不同了。",
    "file": "meiyi_tactic_zwischenzug_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_tactic_zwischenzug_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_zwischenzug",
    "text": "中间这一着，细心的人才看得到。",
    "file": "meiyi_tactic_zwischenzug_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_tactic_sacrifice_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_sacrifice",
    "text": "这枚子舍得有道理。",
    "file": "meiyi_tactic_sacrifice_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_tactic_sacrifice_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_sacrifice",
    "text": "不怕付出，就怕没算清。",
    "file": "meiyi_tactic_sacrifice_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_tactic_sacrifice_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_sacrifice",
    "text": "你这次让出去的，换回了好东西。",
    "file": "meiyi_tactic_sacrifice_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_tactic_sacrifice_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "tactic_sacrifice",
    "text": "舍一枚赚个主动，账没糊涂。",
    "file": "meiyi_tactic_sacrifice_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_key_threat_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "key_threat",
    "text": "我这儿有事儿，你可别装没看见。",
    "file": "meiyi_key_threat_01.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_key_threat_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "key_threat",
    "text": "这个威胁，得先料理。",
    "file": "meiyi_key_threat_02.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_key_threat_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "key_threat",
    "text": "别光忙自己的，眼前有麻烦。",
    "file": "meiyi_key_threat_03.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_key_threat_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "key_threat",
    "text": "我下一步要动真格，你看好了。",
    "file": "meiyi_key_threat_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_check_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "check",
    "text": "将军啦，先顾王要紧。",
    "file": "meiyi_check_01.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_check_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "check",
    "text": "你的王被叫住了，别忙别的。",
    "file": "meiyi_check_02.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_check_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "check",
    "text": "这一将，得马上接着。",
    "file": "meiyi_check_03.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_check_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "check",
    "text": "王的事儿排前头，其他等会儿。",
    "file": "meiyi_check_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_player_check_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_check",
    "text": "你将军了，我得先接着。",
    "file": "meiyi_player_check_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_check_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_check",
    "text": "哟，我的王也忙起来了。",
    "file": "meiyi_player_check_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_check_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_check",
    "text": "这一声听见了，我来回话。",
    "file": "meiyi_player_check_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_check_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_check",
    "text": "压力给到我，这回不闲着啦。",
    "file": "meiyi_player_check_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_missed_mate_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "missed_mate",
    "text": "刚才能将杀，你给漏过去了。",
    "file": "meiyi_missed_mate_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_missed_mate_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "missed_mate",
    "text": "都到门口了，怎么又拐弯啦。",
    "file": "meiyi_missed_mate_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_missed_mate_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "missed_mate",
    "text": "杀棋没看着，这里要记一笔。",
    "file": "meiyi_missed_mate_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_missed_mate_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "missed_mate",
    "text": "机会来过，可惜没端住。",
    "file": "meiyi_missed_mate_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_blunder_into_mate_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "blunder_into_mate",
    "text": "这步把王送进必杀了。",
    "file": "meiyi_blunder_into_mate_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_blunder_into_mate_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "blunder_into_mate",
    "text": "出口都堵了，这下没法绕。",
    "file": "meiyi_blunder_into_mate_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_blunder_into_mate_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "blunder_into_mate",
    "text": "你这一下，直接把结尾定了。",
    "file": "meiyi_blunder_into_mate_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_blunder_into_mate_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "blunder_into_mate",
    "text": "王走进死胡同，可不容易出来。",
    "file": "meiyi_blunder_into_mate_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_mate_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "mate",
    "text": "将杀，今天这盘收工。",
    "file": "meiyi_mate_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_mate_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "mate",
    "text": "王没路了，咱们复盘说。",
    "file": "meiyi_mate_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_mate_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "mate",
    "text": "这盘结束，得失都记心上。",
    "file": "meiyi_mate_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_mate_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "mate",
    "text": "最后这一将，已经没法解了。",
    "file": "meiyi_mate_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_castling_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "castling",
    "text": "易位搬家，王总算安稳了。",
    "file": "meiyi_castling_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_castling_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "castling",
    "text": "王有着落，车也别闲着。",
    "file": "meiyi_castling_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_castling_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "castling",
    "text": "这次安排挺利索。",
    "file": "meiyi_castling_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_castling_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "castling",
    "text": "王车一调整，家里像样多了。",
    "file": "meiyi_castling_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_promotion_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "promotion",
    "text": "小兵熬出头，升变啦。",
