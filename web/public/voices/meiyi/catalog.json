    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_lia_best_move_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "lia_best_move",
    "text": "我出个题，看看你怎么解。",
