    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_brilliant_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_brilliant",
    "text": "你这脑子，今天转得漂亮。",
