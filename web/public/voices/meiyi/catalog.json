    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_capture_minor_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "capture_minor",
    "text": "看着小，马象也金贵。",
    "file": "meiyi_capture_minor_02.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_capture_minor_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "capture_minor",
    "text": "少个帮手，可别不当回事。",
