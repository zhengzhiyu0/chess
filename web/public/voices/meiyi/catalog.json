    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_capture_pawn_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "capture_pawn",
    "text": "这颗小兵，我不嫌少。",
