    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_capture_queen_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "capture_queen",
    "text": "这一口够重，先别乱了阵脚。",
