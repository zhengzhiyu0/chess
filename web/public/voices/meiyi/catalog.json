    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_capture_pawn_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "capture_pawn",
    "text": "你这兵没人管，我给领走了。",
    "file": "meiyi_capture_pawn_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_capture_minor_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "capture_minor",
    "text": "这枚轻子，归我保管啦。",
