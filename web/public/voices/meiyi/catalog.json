    "actors": [
      "opponent"
    ]
  },
  {
    "id": "meiyi_lia_best_move_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "lia_best_move",
    "text": "这一步你细看，可有讲究。",
