    "id": "meiyi_promotion_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "promotion",
    "text": "一路走到底，总算换了身份。",
    "file": "meiyi_promotion_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_promotion_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "promotion",
    "text": "这枚兵有出息，真走到了。",
    "file": "meiyi_promotion_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_promotion_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "promotion",
    "text": "新棋子来帮忙，账又得重算。",
    "file": "meiyi_promotion_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "meiyi_queen_early_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "queen_early",
    "text": "后出早了，满场跑腿。",
    "file": "meiyi_queen_early_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_queen_early_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "queen_early",
    "text": "其他子还没起床，后先忙上啦。",
    "file": "meiyi_queen_early_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_queen_early_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "queen_early",
    "text": "这么早出后，亏了几趟工夫。",
    "file": "meiyi_queen_early_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_queen_early_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "queen_early",
    "text": "别让贵重的棋子跑无用的路。",
    "file": "meiyi_queen_early_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_defense_found_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "defense_found",
    "text": "守得好，亏你没着急。",
    "file": "meiyi_defense_found_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_defense_found_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "defense_found",
    "text": "这口子堵上，心里就稳了。",
    "file": "meiyi_defense_found_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_defense_found_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "defense_found",
    "text": "困难时候不乱，才叫本事。",
    "file": "meiyi_defense_found_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_defense_found_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "defense_found",
    "text": "你这一下，把大麻烦挡回去了。",
    "file": "meiyi_defense_found_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_missed_tactic_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_missed_tactic",
    "text": "战术机会就在这儿，可惜漏了。",
    "file": "meiyi_player_missed_tactic_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_missed_tactic_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_missed_tactic",
    "text": "别光数棋子，还得看它们搭伙。",
    "file": "meiyi_player_missed_tactic_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_missed_tactic_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_missed_tactic",
    "text": "这步本来能多赚一笔。",
    "file": "meiyi_player_missed_tactic_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_missed_tactic_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_missed_tactic",
    "text": "再细看一层，收获就不止这些。",
    "file": "meiyi_player_missed_tactic_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_comeback_01",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "comeback",
    "text": "你还真把这局面给追回来啦。",
    "file": "meiyi_comeback_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_comeback_02",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "comeback",
    "text": "没放弃就有机会，这不来了。",
    "file": "meiyi_comeback_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_comeback_03",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "comeback",
    "text": "这段挺得好，我看着都替你高兴。",
    "file": "meiyi_comeback_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_comeback_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "comeback",
    "text": "重新有了盼头，可别又松手。",
    "file": "meiyi_comeback_04.m4a",
    "actors": [
      "player"
    ]
  }
