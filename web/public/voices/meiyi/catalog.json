    "actors": [
      "player"
    ]
  },
  {
    "id": "meiyi_player_accurate_04",
    "role": "meiyi",
    "coachIndex": 7,
    "category": "player_accurate",
    "text": "这一下，账算得明白。",
    "file": "meiyi_player_accurate_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
