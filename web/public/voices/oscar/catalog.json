    "id": "oscar_tactic_zwischenzug_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "tactic_zwischenzug",
    "text": "你没有急于回吃，难得的细致。",
    "file": "oscar_tactic_zwischenzug_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_tactic_zwischenzug_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "tactic_zwischenzug",
    "text": "同样的交换，顺序不同便全然不同。",
    "file": "oscar_tactic_zwischenzug_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_tactic_zwischenzug_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "tactic_zwischenzug",
    "text": "这一记中间手，颇见功力。",
    "file": "oscar_tactic_zwischenzug_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_tactic_sacrifice_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "tactic_sacrifice",
    "text": "舍去子力，是为了更重要的补偿。",
    "file": "oscar_tactic_sacrifice_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_tactic_sacrifice_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "tactic_sacrifice",
    "text": "弃子有据，才称得上胆识。",
    "file": "oscar_tactic_sacrifice_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_tactic_sacrifice_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "tactic_sacrifice",
    "text": "你以物质换取主动，很有见地。",
    "file": "oscar_tactic_sacrifice_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_tactic_sacrifice_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "tactic_sacrifice",
    "text": "这枚子的价值，在它换来的机会中。",
    "file": "oscar_tactic_sacrifice_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_key_threat_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "key_threat",
    "text": "这个威胁，需要一个严谨的回答。",
    "file": "oscar_key_threat_01.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_key_threat_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "key_threat",
    "text": "棋盘提出的问题，不宜拖延。",
    "file": "oscar_key_threat_02.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_key_threat_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "key_threat",
    "text": "请先审视这里的危险。",
    "file": "oscar_key_threat_03.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_key_threat_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "key_threat",
    "text": "我已把局面的矛盾摆在这里。",
    "file": "oscar_key_threat_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_check_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "check",
    "text": "将军，王必须先作答。",
    "file": "oscar_check_01.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_check_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "check",
    "text": "这一将，暂时打断你的构思。",
    "file": "oscar_check_02.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_check_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "check",
    "text": "你的王受到直接的挑战。",
    "file": "oscar_check_03.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_check_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "check",
    "text": "先处理将军，再谈其余计划。",
    "file": "oscar_check_04.m4a",
    "actors": [
      "opponent"
    ]
  },
  {
    "id": "oscar_player_check_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_check",
    "text": "你的将军，我已收到。",
    "file": "oscar_player_check_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_player_check_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_check",
    "text": "看来我的王需要一番调整。",
    "file": "oscar_player_check_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_player_check_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_check",
    "text": "这一问有力，我当仔细回应。",
    "file": "oscar_player_check_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_player_check_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_check",
    "text": "你施加的压力，值得推敲。",
    "file": "oscar_player_check_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_missed_mate_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "missed_mate",
    "text": "可惜，方才存在一条强制杀棋。",
    "file": "oscar_missed_mate_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_missed_mate_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "missed_mate",
    "text": "结局本可写下，你却另起一行。",
    "file": "oscar_missed_mate_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_missed_mate_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "missed_mate",
    "text": "这次错失，值得完整地复算。",
    "file": "oscar_missed_mate_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_missed_mate_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "missed_mate",
    "text": "杀棋的机会已经过去，不妨记住。",
    "file": "oscar_missed_mate_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_blunder_into_mate_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "blunder_into_mate",
    "text": "这一步，通向了无法避免的将杀。",
    "file": "oscar_blunder_into_mate_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_blunder_into_mate_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "blunder_into_mate",
    "text": "王的退路，在这里被彻底封住。",
    "file": "oscar_blunder_into_mate_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_blunder_into_mate_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "blunder_into_mate",
    "text": "一个疏忽，写定了整盘的结尾。",
    "file": "oscar_blunder_into_mate_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_blunder_into_mate_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "blunder_into_mate",
    "text": "局面从这一着起，失去了转圜。",
    "file": "oscar_blunder_into_mate_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_mate_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "mate",
    "text": "将杀，棋局至此合卷。",
    "file": "oscar_mate_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_mate_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "mate",
    "text": "王已无路，对局结束。",
    "file": "oscar_mate_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_mate_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "mate",
    "text": "终局落定，我们再看其间的得失。",
    "file": "oscar_mate_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_mate_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "mate",
    "text": "这盘棋以将杀画下句点。",
    "file": "oscar_mate_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_castling_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "castling",
    "text": "易位完成，安王与用车得以兼顾。",
    "file": "oscar_castling_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_castling_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "castling",
    "text": "王先安顿，棋子的协调才从容。",
    "file": "oscar_castling_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_castling_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "castling",
    "text": "这一调整，很有必要。",
    "file": "oscar_castling_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_castling_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "castling",
    "text": "王车各得其所，部署更完整了。",
    "file": "oscar_castling_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_promotion_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "promotion",
    "text": "兵抵达底线，完成了升变。",
    "file": "oscar_promotion_01.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_promotion_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "promotion",
    "text": "漫长的行进，换来新的身份。",
    "file": "oscar_promotion_02.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_promotion_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "promotion",
    "text": "小兵的价值，在此发生质变。",
    "file": "oscar_promotion_03.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_promotion_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "promotion",
    "text": "新的子力登场，旧的判断需更新。",
    "file": "oscar_promotion_04.m4a",
    "actors": [
      "player",
      "opponent"
    ]
  },
  {
    "id": "oscar_queen_early_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "queen_early",
    "text": "后出得过早，发展因而失衡。",
    "file": "oscar_queen_early_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_queen_early_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "queen_early",
    "text": "贵重的棋子，也会被节奏束缚。",
    "file": "oscar_queen_early_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_queen_early_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "queen_early",
    "text": "其他棋子尚未就位，后便先行了。",
    "file": "oscar_queen_early_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_queen_early_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "queen_early",
    "text": "过早出后，常要为往返付出代价。",
    "file": "oscar_queen_early_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_defense_found_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "defense_found",
    "text": "防守的价值，不逊于进攻。",
    "file": "oscar_defense_found_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_defense_found_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "defense_found",
    "text": "你找到了那条细窄而可靠的路。",
    "file": "oscar_defense_found_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_defense_found_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "defense_found",
    "text": "压力之下，判断仍然清楚。",
    "file": "oscar_defense_found_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_defense_found_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "defense_found",
    "text": "这一着稳住了根本，很好。",
    "file": "oscar_defense_found_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_player_missed_tactic_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_missed_tactic",
    "text": "战术的联系，你暂时漏看了。",
    "file": "oscar_player_missed_tactic_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_player_missed_tactic_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_missed_tactic",
    "text": "棋子之外，还要观察彼此的关系。",
    "file": "oscar_player_missed_tactic_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_player_missed_tactic_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_missed_tactic",
    "text": "这里本有收获，可惜未被兑现。",
    "file": "oscar_player_missed_tactic_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_player_missed_tactic_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "player_missed_tactic",
    "text": "不妨记下此处，再算一次。",
    "file": "oscar_player_missed_tactic_04.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_comeback_01",
    "role": "oscar",
    "coachIndex": 6,
    "category": "comeback",
    "text": "局面被你一点点扳回，难得。",
    "file": "oscar_comeback_01.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_comeback_02",
    "role": "oscar",
    "coachIndex": 6,
    "category": "comeback",
    "text": "坚持精确，终究换来了转机。",
    "file": "oscar_comeback_02.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_comeback_03",
    "role": "oscar",
    "coachIndex": 6,
    "category": "comeback",
    "text": "这一段逆境中的思考，很有价值。",
    "file": "oscar_comeback_03.m4a",
    "actors": [
      "player"
    ]
  },
  {
    "id": "oscar_comeback_04",
    "role": "oscar",
    "coachIndex": 6,
    "category": "comeback",
    "text": "优势未必永恒，你已经证明了。",
    "file": "oscar_comeback_04.m4a",
    "actors": [
      "player"
    ]
  }
]
